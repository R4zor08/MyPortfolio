# Groq API (https://console.groq.com)
# Get a key at: https://console.groq.com/keys
# Local Vite uses VITE_GROQ_API_KEY. On Vercel, prefer GROQ_API_KEY (server-only).
VITE_GROQ_API_KEY=
GROQ_API_KEY=
VITE_GROQ_MODEL=openai/gpt-oss-20b

# Web3Forms (https://web3forms.com) — contact form
VITE_WEB3FORMS_KEY=
